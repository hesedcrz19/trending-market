{
  "name": "trending-market",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:api": "npm run test --workspace=api",
    "test:web": "npm run test --workspace=web",
    "test": "npm run test:api && npm run test:web",
    "e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "e2e": "node ./node_modules/@playwright/test/cli.js test",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:shared": "npm run dev --workspace=@trending-market/shared",
    "dev": "concurrently \"npm run dev:shared\" \"npm run dev:api\" \"npm run dev:web\"",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.60.0",
    "@types/node": "^25.9.2",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1"
  },
  "dependencies": {
    "zod": "4.6.2"
  }
}
